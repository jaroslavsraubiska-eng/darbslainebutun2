# Atskaites ID: RVT-4417
# Robeža gigabaitos: ja brīvās vietas ir mazāk, tiek izvadīts brīdinājums
$robezaGB = 20

$diski = Get-CimInstance -ClassName Win32_LogicalDisk -Filter 'DriveType = 3'

foreach ($disks in $diski) {
    $kopaGB = [math]::Round($disks.Size / 1GB, 1)
    $brivsGB = [math]::Round($disks.FreeSpace / 1GB, 1)
    Write-Output "Disks $($disks.DeviceID)  Kopējais izmērs: $kopaGB GB  Brīvā vieta: $brivsGB GB"
    if ($brivsGB -lt $robezaGB) {
        Write-Output "BRĪDINĀJUMS: diskā $($disks.DeviceID) brīvās vietas ir mazāk par $robezaGB GB!"
    }
}
